{
  "name": "punjabi-music-collaboration",
  "version": "1.0.0",
  "description": "Professional Punjabi Music Collaboration Platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "http-server -p 3000 -c-1",
    "dev": "http-server -p 3000 -c-1 -o",
    "build": "npm run build:assets",
    "build:assets": "echo 'Building assets...'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "validate": "npm run lint && npm run format:check && npm run test"
  },
  "keywords": [
    "punjabi",
    "music",
    "collaboration",
    "platform",
    "matchmaking",
    "real-time",
    "pwa"
  ],
  "author": "Punjabi Music Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amrinderbenipal23-cmd/Project-1.git"
  },
  "bugs": {
    "url": "https://github.com/amrinderbenipal23-cmd/Project-1/issues"
  },
  "homepage": "https://github.com/amrinderbenipal23-cmd/Project-1#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
